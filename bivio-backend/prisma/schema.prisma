model SupportTicket {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  ticketNumber     String       @unique @map("ticket_number")
  issueType        String       @map("issue_type")
  description      String
  status           TicketStatus @default(OPEN)
  adminReply       String?      @map("admin_reply")
  repliedByAdminId String?      @map("replied_by_admin_id") @db.Uuid
  repliedAt        DateTime?    @map("replied_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user             User         @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  repliedByAdmin   User?        @relation("TicketResponder", fields: [repliedByAdminId], references: [id])

  @@index([userId])
