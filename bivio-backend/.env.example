# Copy to .env and fill in real values before running.

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bivio?schema=public"

JWT_SECRET="change-this-to-a-random-32-plus-character-string"
JWT_REFRESH_SECRET="change-this-to-a-different-random-32-plus-character-string"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

REDIS_URL="redis://localhost:6379"

S3_ENDPOINT=""
S3_BUCKET="bivio-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

CORS_ORIGIN="http://localhost:3000"

MAIL_FROM="no-reply@bivio.example"
MAIL_PROVIDER_API_KEY=""
